#!/bin/sh
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM -- 'apps/api/*.php' || true)

if [ -z "$staged" ]; then
  exit 0
fi

# Стек не поднят — пропускаем: проверку всё равно выполнит CI
if ! docker compose -f infra/docker/compose/compose.yaml ps --status running --services 2>/dev/null | grep -q '^api$'; then
  exit 0
fi

files=$(echo "$staged" | sed 's|^apps/api/||')

docker compose -f infra/docker/compose/compose.yaml exec -T api \
  ./vendor/bin/pint --test $files \
  || { echo "Run 'make fix' before committing"; exit 1; }
